<?xml version="1.0" encoding="utf-8"?><!-- 設置介面的佈局檔案,將作為 Fragment 載入到主內容區塊 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F0F0"
    android:orientation="vertical"
    android:weightSum="10">

    <!-- 上方區域單位2：「架上列表」 -->
    <LinearLayout
        android:id="@+id/on_shelf_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="2"
        android:background="#E0E0E0"
        android:orientation="horizontal"
        android:padding="4dp"
        android:weightSum="6">

        <include
            android:id="@+id/shelf_item_1"
            layout="@layout/shelf_item_template"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/shelf_item_2"
            layout="@layout/shelf_item_template"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/shelf_item_3"
            layout="@layout/shelf_item_template"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/shelf_item_4"
            layout="@layout/shelf_item_template"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/shelf_item_5"
            layout="@layout/shelf_item_template"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />

        <include
            android:id="@+id/shelf_item_6"
            layout="@layout/shelf_item_template"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- 下方區域單位8：「刮板區」和「參數設定區」 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:orientation="horizontal"
        android:weightSum="10">

        <!-- 左側 7 單位：「刮板區」 -->
        <FrameLayout
            android:id="@+id/scratch_board_area"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="7"
            android:background="#E3F2FD"
            android:padding="0dp" />

        <!-- 右側 3 單位：「參數設定區」 -->
        <LinearLayout
            android:id="@+id/setting_parameters_container"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="3"
            android:background="#FFFFFF"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/text_parameters_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="0dp"
                android:text="刮刮卡參數設定"
                android:textColor="#333333"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 刮數設定 -->
            <LinearLayout
                android:id="@+id/layout_scratch_count_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="刮數："
                    android:textColor="#333333"
                    android:textSize="14sp" />

                <Spinner
                    android:id="@+id/spinner_scratches_count"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.8"
                    android:entries="@array/scratches_count_options" />

                <!-- 🔹 新增重新整理按鈕 -->
                <ImageButton
                    android:id="@+id/button_refresh_scratch"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:padding="2dp"
                    android:src="@drawable/ic_refresh"
                    android:contentDescription="重新整理" />
            </LinearLayout>

            <!-- ✅ 右側參數區（特獎以下全部放這裡），Spinner=請選擇時會整區隱藏 -->
            <LinearLayout
                android:id="@+id/right_panel_container"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- 特獎設定：左側按鈕；右側輸入框與鉛筆圖標 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button_pick_special_prize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="#FF9800"
                        android:text="特獎"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:minWidth="0dp"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <EditText
                            android:id="@+id/edit_text_special_prize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:enabled="true"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:hint="請選擇"
                            android:inputType="none"
                            android:textSize="12sp"
                            android:paddingLeft="4dp"
                            android:paddingRight="32dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="12dp"
                            android:lineSpacingMultiplier="1.4"
                            android:gravity="top|start" />

                        <!-- ✅ 鉛筆圖標按鈕 -->
                        <ImageButton
                            android:id="@+id/button_special_prize_keyboard"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="使用數字鍵盤輸入"
                            android:padding="2dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="#757575" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 大獎設定：左側按鈕（多選）；右側輸入框與鉛筆圖標 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/button_pick_grand_prize"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:backgroundTint="#4CAF50"
                        android:text="大獎"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:minWidth="0dp"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <EditText
                            android:id="@+id/edit_text_grand_prize"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:enabled="true"
                            android:focusable="false"
                            android:focusableInTouchMode="false"
                            android:hint="請選擇"
                            android:inputType="none"
                            android:textSize="12sp"
                            android:paddingLeft="4dp"
                            android:paddingRight="32dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="12dp"
                            android:lineSpacingMultiplier="1.4"
                            android:gravity="top|start" />

                        <!-- ✅ 鉛筆圖標按鈕 -->
                        <ImageButton
                            android:id="@+id/button_grand_prize_keyboard"
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="使用數字鍵盤輸入"
                            android:padding="2dp"
                            android:src="@android:drawable/ic_menu_edit"
                            app:tint="#757575" />
                    </FrameLayout>
                </LinearLayout>

                <!-- 夾出X樣,贈送Y刮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="0dp"
                    android:orientation="vertical">

                    <!-- readonly純顯示區塊 -->
                    <TextView
                        android:id="@+id/textPitchRuleReadonly"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="2dp"
                        android:visibility="gone"
                        android:text="消費 0 元，贈送 0 刮"
                        android:textSize="16sp"
                        android:textColor="@android:color/black" />

                    <!-- Phase 1.1：贈送規則切換（版面微調） -->
                    <RadioGroup
                        android:id="@+id/radioGroupPitchType"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="0dp"
                        android:layout_marginBottom="2dp"
                        android:padding="0dp">

                        <RadioButton
                            android:id="@+id/radioPitchScratch"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:layout_margin="0dp"
                            android:padding="0dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:gravity="center_vertical"
                            android:text="夾出贈送" />

                        <RadioButton
                            android:id="@+id/radioPitchShopping"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_margin="0dp"
                            android:padding="0dp"
                            android:minHeight="0dp"
                            android:minWidth="0dp"
                            android:gravity="center_vertical"
                            android:text="消費贈送" />
                    </RadioGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_claws_prefix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:text="夾出"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <!-- 原本的 Spinner：夾出（1-5） -->
                            <Spinner
                                android:id="@+id/spinnerClawsCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:entries="@array/number_options" />

                            <!-- 新增：消費贈送用 Input -->
                            <EditText
                                android:id="@+id/editClawsCount"
                                android:layout_width="80dp"
                                android:layout_height="30dp"
                                android:hint="0"
                                android:inputType="number"
                                android:focusable="false"
                                android:clickable="true"
                                android:background="@android:drawable/edit_text"
                                android:includeFontPadding="false"
                                android:minHeight="0dp"
                                android:paddingTop="0dp"
                                android:paddingBottom="0dp"
                                android:paddingStart="8dp"
                                android:paddingEnd="8dp"
                                android:textSize="12sp"
                                android:cursorVisible="false"
                                android:visibility="gone" />

                        </FrameLayout>

                        <TextView
                            android:id="@+id/text_claws_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:text="樣"
                            android:textColor="#333333"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/text_giveaway_prefix"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:text="贈送"
                            android:textColor="#333333"
                            android:textSize="14sp" />

                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <Spinner
                                android:id="@+id/spinnerGiveawayCount"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:entries="@array/number_options" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/text_giveaway_unit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:text="刮"
                            android:textColor="#333333"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- 儲存按鈕 -->
                <Button
                    android:id="@+id/button_save_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:backgroundTint="#2196F3"
                    android:text="儲存"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"/>

                <!-- 設為使用中 -->
                <Button
                    android:id="@+id/button_toggle_inuse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="設為使用中（★）"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"/>

                <!-- 自動刮開 -->
                <Button
                    android:id="@+id/button_auto_scratch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="自動刮開"
                    android:enabled="false"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"/>

                <!-- 返回／刪除 -->
                <LinearLayout
                    android:id="@+id/row_actions_return_delete"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <Button
                        android:id="@+id/button_return_selected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="↻ 返回"
                        android:textSize="14sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"/>

                    <Space
                        android:layout_width="6dp"
                        android:layout_height="wrap_content" />

                    <Button
                        android:id="@+id/button_delete_selected"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🗑️ 刪除"
                        android:textSize="14sp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minHeight="0dp"/>
                </LinearLayout>

                <Button
                    android:id="@+id/button_back_to_master"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="返回上一層"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minHeight="0dp"
                    android:visibility="gone"/>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <!-- 右下角溫馨提醒（小字、淺灰、靠右） -->
                <TextView
                    android:id="@+id/text_tip_watch_out"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="4dp"
                    android:gravity="end"
                    android:text="溫馨提醒：在設定特獎及大獎時,請注意後面有眼👀"
                    android:textColor="#9E9E9E"
                    android:textSize="8sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>